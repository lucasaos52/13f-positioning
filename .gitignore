# environments
.venv/
crowdflow/.venv/
__pycache__/
*.pyc
.pytest_cache/
pytest-cache-files-*/

# data lakes and caches (rebuilt by bootstrap.py / module scripts)
crowdflow/data/
factors/data/
factors/general_plan/data/
factors/*/data/
notebooks/data/*.csv
*.parquet
*.csv.gz
*.tar.gz
*.jsonl
*.zip

# small essential reference kept in-repo (consumed by other modules;
# rebuilt by the ETF_strat pipeline if absent)
!factors/ETF_strat/data/etf_universe_flags.csv

# keep small result CSVs that document verdicts
!factors/*/results/*.csv
!data-quality-check/results/*.csv
!docs/paper/data/*.csv

# oversized event dumps (regenerated by their modules) - AFTER the
# negation above so these specific ignores win
factors/copycat_pop/results/pop_events.csv
factors/restatement_shock/results/rs_events.csv
factors/ETF_strat/results/backtest_returns.csv
factors/ETF_strat/results/candidate_diagnostics/
factors/stress_short/results/stress_short_events.csv
factors/ETF_strat/data_smoke/

# logs and LaTeX aux
*.log
*.aux
*.out
*.toc
*.synctex.gz
docs/paper/c*.log

# third-party material and personal notes (not for distribution)
papers/
pdfs-intructions/
links uteis.txt
13f_colocar_memo.docx
CONTEXT_HANDOFF.md

# superseded Portuguese-language documents (repo is English-only)
docs/CONCLUSOES_13F.*
docs/FATORES_CLASSICOS_E_INTERACOES.*

# local backups
*_v1old*
*.bak
